    "manifest": {
      "id": "utility",
      "api_version": 1,
      "package_version": "0.1.0",
      "core_requires": ">=0.1,<1",
      "dependencies": {},
      "resource_descriptions": {},
      "config_variables": []
    },
    "actions": [
      {
        "id": "utility.now",
        "description": "读取当前时间并按指定时区返回 ISO 时间与秒级编号片段",
        "input_schema": {
          "type": "object",
          "properties": {
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "iso": {
              "type": "string"
            },
            "compact": {
              "type": "string",
              "pattern": "^[0-9]{14}$"
            },
            "timezone": {
              "type": "string"
            }
          },
          "required": [
            "iso",
            "compact",
            "timezone"
          ],
          "additionalProperties": false
        },
        "effect": "READ",
        "timeout_ms": 30000,
        "retry_safe": false,
        "resource_ids": []
      },
      {
        "id": "utility.uuid",
        "description": "生成 UUID v4 标识",
        "input_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        "effect": "READ",
        "timeout_ms": 30000,
        "retry_safe": false,
        "resource_ids": []
      },
      {
        "id": "utility.decimal",
        "description": "精确十进制四则运算，按指定小数位舍入并返回字符串",
        "input_schema": {
          "type": "object",
          "properties": {
            "operation": {
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide"
              ]
            },
            "left": {
              "type": "string",
              "pattern": "^-?[0-9]{1,30}(?:\\.[0-9]{1,18})?$"
            },
            "right": {
              "type": "string",
              "pattern": "^-?[0-9]{1,30}(?:\\.[0-9]{1,18})?$"
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "rounding": {
              "enum": [
                "HALF_UP",
                "HALF_EVEN",
                "DOWN"
              ]
            }
          },
          "required": [
            "operation",
            "left",
            "right",
            "scale"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^-?[0-9]{1,64}(?:\\.[0-9]{1,12})?$"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        "effect": "READ",
        "timeout_ms": 30000,
        "retry_safe": true,
        "resource_ids": []
      }
    ]
