    {
      "id": "TW-LOCAL-TIDB-001",
      "status": "已修复并验证",
      "symptom": "ENV-01数据库连接、TREATY-02及BILL-02快照读取均在目标SELECT前失败，TIDB_QUERY_FAILED，数据库错误码1235。",
      "evidence_runs": [
        "f7c869bc-9f32-426d-ad5d-c42d6016a2e4",
